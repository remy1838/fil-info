<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#171021">
<ImageView android:id="@+id/art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="GTA VI, compte à rebours France"/>
<LinearLayout android:id="@+id/timer_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="bottom|center_horizontal">
<Chronometer android:id="@+id/chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textStyle="bold" android:fontFamily="monospace" android:textSize="30sp" android:countDown="true" android:format="%s" android:gravity="center"/>
<TextView android:id="@+id/time_labels" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HEURES · MINUTES · SECONDES" android:textColor="#E9DCEB" android:textSize="8sp" android:gravity="center"/>
</LinearLayout></FrameLayout>